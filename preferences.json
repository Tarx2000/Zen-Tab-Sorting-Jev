[
  {
    "type": "separator",
    "label": "Group Rules"
  },
  {
    "type": "checkbox",
    "label": "Enable deterministic domain rules (Pass 1) — off by default so JEV & Fallback-LLM sort dynamically by context",
    "property": "extensions.zen-auto-organize.use-domain-rules",
    "defaultValue": false
  },

  {
    "type": "separator",
    "label": "Skip Domains"
  },

  {
    "type": "separator",
    "label": "Backup & Restore"
  },

  {
    "type": "separator",
    "label": "Look & Feel"
  },
  {
    "type": "checkbox",
    "label": "Minimal style — strip group colors and match Zen's address-bar styling",
    "property": "extensions.zen-auto-organize.minimal-style",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Strict rule enforcement — eject tabs from a group when their hostname isn't in that group's rule",
    "property": "extensions.zen-auto-organize.strict-rules",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Collapsed group marker — the colored dot shown left of a collapsed group's name",
    "property": "extensions.zen-auto-organize.pip-shape",
    "defaultValue": "circle",
    "placeholder": false,
    "options": [
      { "label": "Circle", "value": "circle" },
      { "label": "Rounded square", "value": "square" },
      { "label": "None", "value": "none" }
    ]
  },
  {
    "type": "dropdown",
    "label": "When a group is open — how the marker behaves once the group is expanded",
    "property": "extensions.zen-auto-organize.pip-open-behavior",
    "defaultValue": "smaller",
    "placeholder": false,
    "options": [
      { "label": "Smaller marker", "value": "smaller" },
      { "label": "Same size", "value": "same" },
      { "label": "No marker", "value": "hidden" }
    ]
  },
  {
    "type": "string",
    "label": "Circle marker size in pixels (4–24)",
    "property": "extensions.zen-auto-organize.pip-size-circle",
    "defaultValue": "8",
    "placeholder": "8"
  },
  {
    "type": "string",
    "label": "Rounded square marker size in pixels (4–24)",
    "property": "extensions.zen-auto-organize.pip-size-square",
    "defaultValue": "8",
    "placeholder": "8"
  },

  {
    "type": "separator",
    "label": "AI Sorting"
  },
  {
    "type": "dropdown",
    "label": "AI engine",
    "property": "extensions.zen-auto-organize.ai-engine",
    "defaultValue": "jev",
    "options": [
      { "label": "JEV + Fallback-LLM — TypeSafe JEV for existing groups + One-Shot LLM for new groups", "value": "jev" },
      { "label": "ChatGPT (Sign in with ChatGPT) — Use your ChatGPT Plus/Pro quota", "value": "chatgpt" },
      { "label": "PrimaLabs — Fast OpenAI-compatible API (DeepSeek V4.1 Flash)", "value": "primalabs" },
      { "label": "OpenAI-compatible — Remote or self-hosted /v1/chat/completions", "value": "openai" },
      { "label": "Gemini — Google AI Studio generateContent", "value": "gemini" },
      { "label": "Ollama — Stronger model, requires Ollama running locally", "value": "ollama" },
      { "label": "Local — Built-in model, limited capability", "value": "local" },
      { "label": "Custom — OpenAI or Ollama-compatible endpoint", "value": "custom" }
    ]
  },
  {
    "type": "checkbox",
    "label": "Allow sending tab titles, URLs, and optional page snippets to the selected provider",
    "property": "extensions.zen-auto-organize.ai-provider-consent",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "JEV provider (Stage 1: classify into existing workspace tab groups)",
    "property": "extensions.zen-auto-organize.ai-jev-provider",
    "defaultValue": "typesafe",
    "placeholder": false,
    "options": [
      { "label": "Official TypeSafe API — https://api.typesafe.ai/v1/systemone", "value": "typesafe" },
      { "label": "OpenRouter Decisions API — https://openrouter.ai/api/alpha/decisions", "value": "openrouter" }
    ]
  },
  {
    "type": "string",
    "label": "JEV API key (TypeSafe or OpenRouter key)",
    "property": "extensions.zen-auto-organize.ai-jev-api-key",
    "defaultValue": "",
    "placeholder": "Bearer key for TypeSafe or OpenRouter"
  },
  {
    "type": "string",
    "label": "JEV model",
    "property": "extensions.zen-auto-organize.ai-jev-model",
    "defaultValue": "jev-1.13.0",
    "placeholder": "jev-1.13.0 or typesafe/jev-1.13"
  },
  {
    "type": "string",
    "label": "JEV Min Probability (0.05–0.99 or 5%–99% — minimum confidence to sort into an existing group)",
    "property": "extensions.zen-auto-organize.ai-jev-min-prob",
    "defaultValue": "0.70",
    "placeholder": "0.70 (or 70%)"
  },
  {
    "type": "string",
    "label": "JEV Min Margin (0.00–0.99 or 0%–99% — minimum lead of #1 group over #2 group)",
    "property": "extensions.zen-auto-organize.ai-jev-min-margin",
    "defaultValue": "0.15",
    "placeholder": "0.15 (or 15%)"
  },
  {
    "type": "dropdown",
    "label": "Fallback-LLM for new groups (Stage 2: One-Shot clustering of leftover ungrouped tabs)",
    "property": "extensions.zen-auto-organize.ai-fallback-provider",
    "defaultValue": "chatgpt",
    "placeholder": false,
    "options": [
      { "label": "ChatGPT (Sign in with ChatGPT — uses your ChatGPT subscription quota)", "value": "chatgpt" },
      { "label": "PrimaLabs API (https://api.primalabs.ai/v1 — DeepSeek V4.1 Flash)", "value": "primalabs" },
      { "label": "OpenAI-compatible — Custom Base URL, API key & model", "value": "openai" },
      { "label": "Gemini — Google AI Studio generateContent", "value": "gemini" },
      { "label": "Ollama — Local Ollama model", "value": "ollama" },
      { "label": "Custom — OpenAI or Ollama-compatible endpoint", "value": "custom" },
      { "label": "Off — Only sort into existing groups with JEV", "value": "off" }
    ]
  },
  {
    "type": "dropdown",
    "label": "Sorting mode",
    "property": "extensions.zen-auto-organize.ai-sort-mode",
    "defaultValue": "rules-first",
    "placeholder": false,
    "options": [
      { "label": "Rules first — Use domain rules, then AI for leftovers", "value": "rules-first" },
      { "label": "Hybrid — Fast rules first, then AI-sort unmatched tabs every run", "value": "hybrid" },
      { "label": "Full AI — Ignore rules and re-cluster all eligible tabs", "value": "full-ai" }
    ]
  },
  {
    "type": "dropdown",
    "label": "When AI assigns a tab to an existing group",
    "property": "extensions.zen-auto-organize.ai-existing-behavior",
    "defaultValue": "transient",
    "placeholder": false,
    "options": [
      { "label": "Transient — Move the tab only, rules untouched", "value": "transient" },
      { "label": "Always-add — Append the tab's domain to the matched rule (rules grow)", "value": "always-add" }
    ]
  },
  {
    "type": "dropdown",
    "label": "When AI creates a new group",
    "property": "extensions.zen-auto-organize.ai-new-group-behavior",
    "defaultValue": "transient",
    "placeholder": false,
    "options": [
      { "label": "Transient — Create the group only, no rule added", "value": "transient" },
      { "label": "Auto-add — Create the group and save it as a new rule", "value": "auto-add" },
      { "label": "Prompt — Open Zen's edit modal to confirm name and color", "value": "prompt" },
      { "label": "Fresh categories — Re-tidy ALL tabs into AI-invented groups, ignoring rules", "value": "fresh-categories" },
      { "label": "Plan Mode — Preview the AI's plan, pick which groups to keep, optionally re-assign", "value": "identify-only" }
    ]
  },
  {
    "type": "string",
    "label": "Ollama host",
    "property": "extensions.zen-auto-organize.ai-ollama-host",
    "defaultValue": "http://localhost:11434"
  },
  {
    "type": "string",
    "label": "Ollama model",
    "property": "extensions.zen-auto-organize.ai-ollama-model",
    "defaultValue": "qwen2.5:1.5b"
  },
  {
    "type": "checkbox",
    "label": "Keep Ollama model warm — preloads at browser start and keeps it loaded between clicks (faster tidy clicks; uses VRAM continuously)",
    "property": "extensions.zen-auto-organize.ai-ollama-warmup",
    "defaultValue": true
  },
  {
    "type": "string",
    "label": "Local AI batch size (only used when >75 unmatched tabs; smaller = gentler on CPU, larger = faster)",
    "property": "extensions.zen-auto-organize.ai-local-batch-size",
    "defaultValue": "30"
  },
  {
    "type": "separator",
    "label": "Remote Provider Settings"
  },
  {
    "type": "string",
    "label": "ChatGPT model (used with Sign in with ChatGPT)",
    "property": "extensions.zen-auto-organize.ai-chatgpt-model",
    "defaultValue": "gpt-5-codex-mini",
    "placeholder": "gpt-5-codex-mini"
  },
  {
    "type": "string",
    "label": "PrimaLabs endpoint",
    "property": "extensions.zen-auto-organize.ai-primalabs-endpoint",
    "defaultValue": "https://api.primalabs.ai/v1",
    "placeholder": "https://api.primalabs.ai/v1"
  },
  {
    "type": "string",
    "label": "PrimaLabs API key",
    "property": "extensions.zen-auto-organize.ai-primalabs-api-key",
    "defaultValue": "",
    "placeholder": "Bearer key for api.primalabs.ai"
  },
  {
    "type": "string",
    "label": "PrimaLabs model",
    "property": "extensions.zen-auto-organize.ai-primalabs-model",
    "defaultValue": "primalabs-ai/DeepSeek-V4.1-Flash-1017",
    "placeholder": "primalabs-ai/DeepSeek-V4.1-Flash-1017"
  },
  {
    "type": "string",
    "label": "OpenAI-compatible endpoint",
    "property": "extensions.zen-auto-organize.ai-openai-endpoint",
    "defaultValue": "",
    "placeholder": "https://api.openai.com/v1"
  },
  {
    "type": "string",
    "label": "OpenAI-compatible API key",
    "property": "extensions.zen-auto-organize.ai-openai-api-key",
    "defaultValue": "",
    "placeholder": "sk-..."
  },
  {
    "type": "string",
    "label": "OpenAI-compatible model",
    "property": "extensions.zen-auto-organize.ai-openai-model",
    "defaultValue": "",
    "placeholder": "gpt-4o-mini"
  },
  {
    "type": "string",
    "label": "Gemini API key",
    "property": "extensions.zen-auto-organize.ai-gemini-api-key",
    "defaultValue": "",
    "placeholder": "AIza..."
  },
  {
    "type": "string",
    "label": "Gemini model",
    "property": "extensions.zen-auto-organize.ai-gemini-model",
    "defaultValue": "",
    "placeholder": "gemini-2.5-flash"
  },
  {
    "type": "string",
    "label": "Custom endpoint",
    "property": "extensions.zen-auto-organize.ai-custom-endpoint",
    "defaultValue": "",
    "placeholder": "https://example.test/v1"
  },
  {
    "type": "string",
    "label": "Custom API key",
    "property": "extensions.zen-auto-organize.ai-custom-api-key",
    "defaultValue": "",
    "placeholder": "optional"
  },
  {
    "type": "string",
    "label": "Custom model",
    "property": "extensions.zen-auto-organize.ai-custom-model",
    "defaultValue": "",
    "placeholder": "model name"
  },
  {
    "type": "dropdown",
    "label": "Custom request format",
    "property": "extensions.zen-auto-organize.ai-custom-format",
    "defaultValue": "openai",
    "placeholder": false,
    "options": [
      { "label": "OpenAI-compatible chat", "value": "openai" },
      { "label": "Ollama generate", "value": "ollama" }
    ]
  }
]
